ARG BASE_IMAGE=ghcr.io/dmitriy-py/ros2-cuda-base:x86_64
FROM ${BASE_IMAGE}

ARG REPO_URL
ARG REPO_BRANCH="ROS2"
ARG PACKAGE_NAME
ARG CUDA_ARCH="8.7"

ENV CUDA_ARCH=${CUDA_ARCH}
ENV CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH}

WORKDIR /ros2_ws/src

# 1. Клонирование основного репозитория (с автоматическим выбором ветки ROS2)
RUN git clone --recursive ${REPO_URL} pkg_repo && \
    cd pkg_repo && \
    (git checkout ROS2 || git checkout ros2 || git checkout main || true)

# 2. Установка Livox SDK2 и правильная подготовка livox_ros_driver2
RUN if [ "$PACKAGE_NAME" = "FAST_LIO" ] || [ "$PACKAGE_NAME" = "FAST-LIVO2" ]; then \
    git clone https://github.com/Livox-SDK/Livox-SDK2.git && \
    cd Livox-SDK2 && mkdir build && cd build && cmake .. && make -j$(nproc) && make install && cd ../.. && \
    git clone https://github.com/Livox-SDK/livox_ros_driver2.git && \
    cd livox_ros_driver2 && \
    cp package_ROS2.xml package.xml ; \
    fi

WORKDIR /ros2_ws

# 3. Автоматическая установка зависимостей ROS2
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    apt-get update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    rm -rf /var/lib/apt/lists/*

# 4. Сборка workspace с флагами ROS_EDITION=ROS2 и CMAKE_CUDA_ARCHITECTURES
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    colcon build --symlink-install \
    --cmake-args \
      -DCMAKE_BUILD_TYPE=Release \
      -DROS_EDITION=ROS2 \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
      --no-warn-unused-cli

# Настройка сорсинга окружения
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "source /ros2_ws/install/setup.bash" >> ~/.bashrc

ENTRYPOINT ["/bin/bash", "-c", "source /ros2_ws/install/setup.bash && exec \"$@\"", "--"]
CMD ["bash"]
